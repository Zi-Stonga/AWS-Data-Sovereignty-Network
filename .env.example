# Data Sovereignty Network - Environment Configuration
# Copy this file to .env and populate all values before running.
# Never commit .env to version control.

AWS_ACCOUNT_ID_EU=111111111111
AWS_ACCOUNT_ID_APAC=222222222222
AWS_ACCOUNT_ID_US=333333333333
AWS_ORG_ID=o-xxxxxxxxxx
AWS_MANAGEMENT_ACCOUNT_ID=000000000000
SIEM_ENDPOINT=https://your-siem-endpoint.example.com
DPO_PORTAL_ENDPOINT=https://your-dpo-portal.example.com
CLOUDTRAIL_LOG_GROUP=/cloudtrail/data-sovereignty
VPC_FLOW_LOG_GROUP=/vpc/flowlogs
CONFIG_AGGREGATOR_NAME=data-sovereignty-aggregator
ALERT_SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:111111111111:compliance-alerts
LOG_LEVEL=INFO
ENVIRONMENT=production
